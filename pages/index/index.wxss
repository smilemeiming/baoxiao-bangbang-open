.dashboard {
  width: 100%;
}

.entry-title,
.entry-copy,
.entry-button-title,
.entry-button-note,
.entry-symbol,
.summary-title,
.summary-label,
.summary-amount,
.summary-number,
.section-title,
.empty-title,
.empty-copy,
.invoice-title,
.invoice-meta,
.invoice-amount,
.failure-hint,
.failure-badge {
  display: block;
}

.entry-head {
  padding: 8rpx 4rpx 20rpx;
}

.entry-title {
  color: #18212b;
  font-size: 44rpx;
  font-weight: 750;
  line-height: 1.2;
}

.entry-copy {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.entry-stack {
  display: flex;
  width: 100%;
  max-width: 100%;
  align-items: stretch;
  flex-direction: column;
  gap: 24rpx;
}

.entry-button {
  display: flex;
  width: 100%;
  min-width: 100%;
  max-width: none;
  height: 156rpx;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 0;
  padding: 0 32rpx;
  border-radius: 8rpx;
  text-align: left;
}

.entry-button-active {
  opacity: 0.82;
}

.scan-entry {
  border: 2rpx solid #2563eb;
  background: #ffffff;
  color: #2563eb;
}

.scan-entry.disabled {
  border-color: #93b4f4;
  background: #eff6ff;
  color: #647fbd;
  opacity: 1;
}

.file-entry {
  border: 2rpx solid #b8d8cd;
  background: #f8fcfa;
  color: #176b5b;
}

.file-entry.disabled {
  background: #eef5f1;
  color: #6d8f84;
  opacity: 1;
}

.rename-entry {
  border: 2rpx solid #f2c66d;
  background: #fffaf0;
  color: #8a4f00;
}

.rename-entry.disabled {
  border-color: #f1d89d;
  background: #fff7e6;
  color: #9d7a40;
  opacity: 1;
}

.entry-icon-image {
  display: block;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
}

.entry-symbol {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: rgba(138, 79, 0, 0.1);
  font-size: 34rpx;
  font-weight: 800;
}

.entry-button-copy {
  min-width: 0;
}

.entry-button-title {
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.2;
}

.entry-button-note {
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.4;
  opacity: 0.72;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary {
  margin-top: 26rpx;
  padding: 20rpx 22rpx;
  border-top: 4rpx solid #93c5fd;
}

.summary-head,
.summary-row,
.section-head,
.invoice-row {
  display: flex;
  align-items: center;
}

.summary-head {
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #edf0f3;
}

.summary-title {
  color: #18212b;
  font-size: 27rpx;
  font-weight: 700;
}

.summary-link {
  color: #1d4ed8;
  font-size: 25rpx;
  font-weight: 650;
}

.section-link {
  color: #176b5b;
  font-size: 25rpx;
  font-weight: 650;
}

.summary-row {
  min-height: 96rpx;
  padding-top: 16rpx;
}

.amount-stat {
  min-width: 0;
  flex: 1;
}

.summary-label {
  color: #6b7682;
  font-size: 23rpx;
}

.summary-amount {
  margin-top: 5rpx;
  color: #18212b;
  font-size: 36rpx;
  font-weight: 750;
}

.count-stat {
  width: 126rpx;
  padding-left: 12rpx;
  border-left: 1rpx solid #e4e9ee;
  text-align: center;
}

.count-stat .summary-label {
  white-space: nowrap;
}

.summary-number {
  color: #18212b;
  font-size: 30rpx;
  font-weight: 750;
}

.success-number {
  color: #15803d;
}

.failed-number {
  color: #dc2626;
}

.section-title {
  margin: 28rpx 0 14rpx;
  color: #18212b;
  font-size: 31rpx;
  font-weight: 700;
}

.section-title.inline {
  margin: 0;
}

.section-head {
  justify-content: space-between;
  margin: 28rpx 0 14rpx;
}

.empty {
  padding: 28rpx 24rpx;
}

.empty-title {
  color: #18212b;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.invoice-row {
  min-height: 112rpx;
  gap: 14rpx;
  padding: 18rpx;
}

.invoice-row-active {
  opacity: 0.82;
}

.invoice-row-failed {
  border: 2rpx solid #ef4444;
  background: #fff7f7;
}

.invoice-icon {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 29rpx;
}

.invoice-copy {
  min-width: 0;
  flex: 1;
}

.invoice-title {
  overflow: hidden;
  color: #18212b;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invoice-meta {
  overflow: hidden;
  margin-top: 7rpx;
  font-size: 23rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invoice-buyer {
  overflow: hidden;
  margin-top: 4rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.failure-hint {
  margin-top: 5rpx;
  color: #dc2626;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.35;
}

.invoice-right {
  min-width: 126rpx;
  text-align: right;
}

.invoice-amount {
  color: #18212b;
  font-size: 28rpx;
  font-weight: 750;
}

.failure-badge {
  display: inline-flex;
  min-height: 32rpx;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #fee2e2;
  color: #b91c1c;
  font-size: 22rpx;
  font-weight: 700;
}
