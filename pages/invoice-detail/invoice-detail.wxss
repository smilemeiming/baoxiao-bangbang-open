.detail-page {
  padding-bottom: 48rpx;
}

.header-card,
.pair-card,
.archive-card,
.empty {
  padding: 22rpx;
}

.header-card,
.action-bar {
  display: flex;
  align-items: center;
}

.header-card {
  gap: 18rpx;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex: 0 0 auto;
}

.re-recognize-btn {
  display: flex;
  min-width: 130rpx;
  height: 50rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid #93c5fd;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 700;
  line-height: normal;
}

.re-recognize-btn::after {
  border: 0;
}

.re-recognize-btn[disabled] {
  background: #f1f5f9;
  color: #94a3b8;
  border-color: #e2e8f0;
}

.category-icon {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 66rpx;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 31rpx;
}

.header-copy {
  min-width: 0;
  flex: 1;
}

.merchant,
.file-name,
.confidence,
.field-label,
.picker-value,
.pair-title,
.pair-name,
.archive-title,
.archive-line,
.empty-title {
  display: block;
}

.merchant {
  overflow: hidden;
  color: #1b2430;
  font-size: 30rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-name {
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.confidence {
  color: #176b5b;
  font-size: 27rpx;
  font-weight: 700;
}

.form-card {
  margin-top: 16rpx;
  padding: 0 22rpx;
}

.field {
  padding: 17rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.field:last-child {
  border-bottom: 0;
}

.field-label {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 600;
}

.field-input,
.picker-value {
  width: 100%;
  min-height: 56rpx;
  margin-top: 5rpx;
  color: #1b2430;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 56rpx;
}

.field-textarea {
  min-height: 96rpx;
  line-height: 1.45;
}

.field-placeholder {
  color: #60a5fa;
  font-weight: 650;
}

.mono {
  font-family: Consolas, Menlo, monospace;
  font-size: 27rpx;
}

.pair-card {
  margin-top: 16rpx;
  background: #eff6ff;
}

.archive-card {
  margin-top: 16rpx;
}

.pair-title {
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 700;
}

.pair-name {
  margin-top: 8rpx;
  color: #1e3a8a;
  font-size: 30rpx;
  font-weight: 800;
}

.archive-title {
  color: #475569;
  font-size: 26rpx;
  font-weight: 700;
}

.archive-line {
  overflow-wrap: break-word;
  margin-top: 8rpx;
  color: #1b2430;
  font-size: 25rpx;
  line-height: 1.5;
}

.action-bar {
  gap: 12rpx;
  margin-top: 18rpx;
}

.primary-button,
.ghost-button {
  display: flex;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: normal;
  text-align: center;
}

.primary-button {
  flex: 1;
  background: #176b5b;
  color: #ffffff;
}

.ghost-button {
  flex: 1;
  border: 1rpx solid #b8d8cd;
  background: #ffffff;
  color: #176b5b;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.empty-title {
  color: #1b2430;
  font-size: 34rpx;
  font-weight: 800;
}
