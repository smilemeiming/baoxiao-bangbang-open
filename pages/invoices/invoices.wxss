.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 10rpx;
  padding-bottom: 16rpx;
}

.filter-chip {
  display: flex;
  height: 58rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d7e0ea;
  border-radius: 7rpx;
  background: #ffffff;
  color: #475569;
  font-size: 25rpx;
  font-weight: 600;
  line-height: normal;
}

.filter-chip.active {
  border-color: #176b5b;
  background: #176b5b;
  color: #ffffff;
}

.filter-icon {
  font-size: 28rpx;
}

.library-toolbar,
.undo-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.library-toolbar {
  min-height: 86rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #b8d8cd;
  box-shadow: 0 6rpx 16rpx rgba(23, 107, 91, 0.08);
}

.library-toolbar.selection-toolbar {
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx;
  border-color: #8dc8b6;
  background: #f1faf6;
}

.toolbar-title {
  min-width: 0;
  flex: 1;
  color: #1b2430;
  font-size: 28rpx;
  font-weight: 800;
  white-space: nowrap;
}

.toolbar-actions {
  display: flex;
  min-width: 0;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.selection-toolbar .toolbar-title,
.selection-toolbar .toolbar-actions {
  width: 100%;
  flex: 0 0 100%;
}

.selection-toolbar .toolbar-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.selection-toolbar .toolbar-button,
.selection-toolbar .danger-toolbar-button {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  padding: 0 10rpx;
  border: 2rpx solid transparent;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.toolbar-button,
.danger-toolbar-button,
.undo-button {
  display: flex;
  min-width: 112rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: normal;
  text-align: center;
}

.toolbar-button {
  background: #e6f5ef;
  color: #176b5b;
}

.selection-entry-button {
  min-width: 220rpx;
  height: 68rpx;
  padding: 0 28rpx;
  border-radius: 10rpx;
  background: #176b5b;
  box-shadow: 0 6rpx 14rpx rgba(23, 107, 91, 0.2);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.selection-toolbar .select-all-button {
  border-color: #9fd4c2;
  background: #dff4eb;
  color: #126453;
}

.toolbar-button.ghost {
  background: #f1f5f9;
  color: #475569;
}

.selection-toolbar .cancel-selection-button {
  border-color: #cbd5e1;
  background: #ffffff;
}

.danger-toolbar-button {
  background: #dc2626;
  box-shadow: 0 6rpx 14rpx rgba(220, 38, 38, 0.18);
  color: #ffffff;
}

.danger-toolbar-button[disabled] {
  border-color: #e2e8f0;
  background: #f1f5f9;
  box-shadow: none;
  color: #94a3b8;
}

.undo-bar {
  min-height: 78rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #bfe6d5;
  border-radius: 8rpx;
  background: #f1faf6;
}

.undo-copy {
  color: #176b5b;
  font-size: 27rpx;
  font-weight: 700;
}

.undo-button {
  min-width: 96rpx;
  background: #176b5b;
  color: #ffffff;
}

.empty {
  padding: 22rpx;
}

.invoice-card {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 16rpx;
}

.empty-title,
.empty-copy,
.merchant,
.amount-text {
  display: block;
}

.empty-title {
  color: #1b2430;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-copy {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.6;
}

.primary-button {
  display: flex;
  width: 200rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: #176b5b;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: normal;
}

.primary-button::after,
.toolbar-button::after,
.danger-toolbar-button::after,
.undo-button::after {
  border: 0;
}

.invoice-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.invoice-card.selecting {
  border-color: #bfe6d5;
}

.invoice-card.selected {
  border-color: #176b5b;
  background: #f1faf6;
}

.selection-dot {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #7c8b9d;
  border-radius: 50%;
  background: #ffffff;
  color: #ffffff;
  box-shadow: 0 3rpx 8rpx rgba(15, 23, 42, 0.12);
  font-size: 32rpx;
  font-weight: 900;
  line-height: normal;
}

.selection-dot.checked {
  border-color: #176b5b;
  background: #176b5b;
  box-shadow: 0 4rpx 10rpx rgba(23, 107, 91, 0.24);
}

.category-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.main-copy {
  min-width: 0;
  flex: 1;
}

.merchant {
  overflow: hidden;
  color: #1b2430;
  font-size: 27rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.compact-meta {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 7rpx;
  overflow: hidden;
  margin-top: 5rpx;
  font-size: 23rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.compact-meta text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.compact-buyer {
  display: block;
  overflow: hidden;
  margin-top: 3rpx;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-separator {
  flex: 0 0 auto;
  color: #94a3b8;
}

.amount-box {
  min-width: 140rpx;
  flex: 0 0 auto;
  text-align: right;
}

.amount-text {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 800;
}
