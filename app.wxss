page {
  min-height: 100vh;
  background: #f4f7f5;
  color: #18212b;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  text-align: center;
  line-height: normal;
  transition: opacity 120ms ease;
}

button::after {
  border: 0;
}

button:active {
  opacity: 0.82;
}

.safe-page {
  min-height: 100vh;
  padding: 24rpx;
}

.surface {
  border: 1rpx solid #e3e8ee;
  border-radius: 8rpx;
  background: #ffffff;
}

.muted {
  color: #6b7682;
}

.amount {
  font-variant-numeric: tabular-nums;
}
